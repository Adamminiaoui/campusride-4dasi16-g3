            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Common error format\", () => pm.expect(pm.response.json()).to.include.all.keys(\"status\",\"error\",\"message\",\"timestamp\"));"
            ]
          }
        }
      ]
    },
