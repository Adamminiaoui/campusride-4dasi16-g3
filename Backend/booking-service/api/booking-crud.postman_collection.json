        "url": "{{baseUrl}}/dev/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rideId\": 901,\n  \"driverId\": 902,\n  \"passengerId\": 903,\n  \"seats\": 0,\n  \"totalPrice\": 24.5,\n  \"status\": \"PENDING\",\n  \"changedBy\": 903\n}",
          "options": {
            "raw": {
